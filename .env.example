# Public site URL (no trailing slash). Used for metadataBase, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty to run in no-DB mode (reads src/data/seed/*.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by /api/leads and admin writes.
SUPABASE_SERVICE_ROLE_KEY=

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=905000000000
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/eduways.academytr
